# Test Environment Config
NODE_ENV=test
PORT=5001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Test DB)
MONGODB_URI=mongodb://127.0.0.1:27017/astralis_erp_test

# Authentication & Security
JWT_SECRET=astralis_test_super_secret_jwt_key_at_least_32_characters_12345
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=astralis_test_refresh_secret_key_at_least_32_chars_98765
JWT_REFRESH_EXPIRES_IN=7d

# Tenant & Multi-Tenancy Defaults
DEFAULT_TENANT_ID=tenant_test_001
ENABLE_MULTI_TENANT_ISOLATION=true

# Logging
LOG_LEVEL=error

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
