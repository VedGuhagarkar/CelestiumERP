# Production Environment Config (Template / Defaults)
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=https://erp.astralis.internal

# Database (MongoDB Production Connection String)
MONGODB_URI=mongodb://127.0.0.1:27017/astralis_erp_prod

# Authentication & Security (Must be injected via secret manager in production)
JWT_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY_IN_PRODUCTION_ENV_CONTAINER
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_REFRESH_SECRET_KEY_IN_PRODUCTION_ENV
JWT_REFRESH_EXPIRES_IN=7d

# Tenant & Multi-Tenancy Defaults
DEFAULT_TENANT_ID=tenant_primary_001
ENABLE_MULTI_TENANT_ISOLATION=true

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
