# Development Environment Config
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/astralis_erp_dev

# Authentication & Security
JWT_SECRET=astralis_dev_super_secret_jwt_key_at_least_32_characters_long_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=astralis_dev_refresh_secret_key_at_least_32_chars_98765
JWT_REFRESH_EXPIRES_IN=7d

# Tenant & Multi-Tenancy Defaults
DEFAULT_TENANT_ID=tenant_default_001
ENABLE_MULTI_TENANT_ISOLATION=true

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
